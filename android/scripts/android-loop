#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
android_root="$project_root/android"
sdk_root="${ANDROID_HOME:-/var/home/genneth/Android/Sdk}"
adb_bin="$sdk_root/platform-tools/adb"
loop_output="$project_root/target/android-loop"

# Pupil no longer owns an emulator. almon owns one shared, exclusively-leased
# device (~/.local/bin/emulatorctl); this script takes a lease, works, and gives
# it back. See ~/almon/tools/molly-android-dev/SKILL.md.
#
# Geometry must now be stated, never assumed. `wm size reset` used to mean
# pupil's own device panel; on the shared device the physical panel is a
# 2248x2616 superset, so a reset would silently hand Pupil a much larger screen
# than it was ever laid out against.
#
# The owner has exactly one phone: a Find N6 foldable. Its real panel,
# measured with `dumpsys display` on 2026-08-08 (see
# ~/hartley/docs/superpowers/specs/2026-08-08-hartley-typography.md), is
# 1140x2616 folded / 2248x2480 unfolded at density 442 (413dp / 814dp wide).
# 1080x2400 / 2292x2528 @420 were pixel_7 AVD template leftovers, never
# corrected, and were validating pupil's UI against a device nobody owns.
#
# Density is passed explicitly on every acquire below rather than left to
# almon's per-project default in `profile_for()`. Hartley and shamoji made the
# same call: if a value in almon's table ever drifted from what this repo's
# layouts assume, an implicit density would drift silently along with it. An
# explicit --density here means that drift fails loudly instead (a wrong
# emulatorctl entry becomes visibly wrong dp math on screen, not a quiet
# mismatch with almon's table).
emulatorctl="${EMULATORCTL:-$HOME/.local/bin/emulatorctl}"
lease_project=pupil
# One file identifies one workflow across separate start/capture/stop commands.
# Independent sessions in the same checkout must choose distinct files.
lease_token_file="${PUPIL_EMULATOR_LEASE_FILE:-$loop_output/lease-token}"
lease_token=""
case "${1:-}" in
    up|start|wait|install|install-release|test-ui|capture|folded|unfolded|renderer|stop)
        mkdir -p "$(dirname "$lease_token_file")"
        exec 9>"$lease_token_file.lock"
        flock -n 9 || { echo 'Another command is using this emulator lease file.' >&2; exit 1; }
        # Snapshot once: another session must never silently replace our identity.
        [[ ! -s "$lease_token_file" ]] || lease_token=$(<"$lease_token_file")
        ;;
esac
geometry_folded=1140x2616
geometry_unfolded=2248x2480
density=442
lease_wait="${PUPIL_EMULATOR_WAIT:-300}"
release_apk="$android_root/app/build/outputs/apk/release/app-release.apk"
release_version_name="0.3.0"
release_version_code="3"
release_dist="$android_root/dist/pupil-$release_version_name-release.apk"
release_cert_sha256="654746ec3c14cac3498052ac5cf7d7a8a02b87a85cdcd96cd9a19d938b99c6e5"

run_dev() {
    toolbox run -c dev "$@" 9>&-
}

adb_all() {
    run_dev "$adb_bin" "$@"
}

require_lease_token() {
    if [[ ! "$lease_token" =~ ^[A-Za-z0-9]+$ ]]; then
        echo 'No valid lease token. Run `android-loop start` (or `up`) first.' >&2
        return 1
    fi
}

emulator_serial() {
    require_lease_token || return 1
    "$emulatorctl" serial "$lease_project" --lease "$lease_token" 9>&-
}

adb() {
    local serial
    serial=$(emulator_serial) || return 1
    [[ -n "$serial" ]] || { echo 'The leased emulator has no serial.' >&2; return 1; }
    adb_all -s "$serial" "$@"
}

# Acquiring the shared device IS the renderer decision: emulatorctl launches
# software rendering only, and does not carry a hardware-GPU path at all. That
# is deliberate. On 2026-08-13 a `-no-window` emulator with `-gpu host` took a
# hardware Vulkan context on the RTX 4090, deadlocked
# restoring a snapshot, and froze the desktop for 29 minutes; the box needed a
# hard reset. Pupil carried the identical default and was one invocation away
# from the same outcome.
#
# Acquire also RESETS the device from almon's baseline snapshot, so a round never
# inherits the previous holder's installs, geometry or reverse bindings. That is
# stronger determinism than the cold boot this used to do, and much faster
# (~8s including reset, against ~19s to cold boot).
start_emulator() {
    local geometry="${1:-$geometry_folded}"
    mkdir -p "$loop_output"
    case "$geometry" in
        folded)   geometry="$geometry_folded" ;;
        unfolded) geometry="$geometry_unfolded" ;;
        software|host)
            echo "Renderer is not selectable any more: the shared device is software-only." >&2
            echo "Pass a geometry instead (folded|unfolded|WxH), or nothing for folded." >&2
            exit 2 ;;
    esac
    local acquire_log token token_tmp
    local lease_args=()
    if [[ -n "$lease_token" ]]; then
        require_lease_token || return 1
        lease_args=(--lease "$lease_token")
    fi
    # The controller announces new tokens on stderr; renewals retain our token.
    if ! acquire_log=$("$emulatorctl" acquire "$lease_project" "${lease_args[@]}" \
        --geometry "$geometry" --density "$density" --wait "$lease_wait" 9>&- 2>&1 >/dev/null); then
        printf '%s\n' "$acquire_log" >&2
        return 1
    fi
    printf '%s\n' "$acquire_log" >&2
    token=$(sed -n 's/.*lease token: \([A-Za-z0-9]\{1,\}\).*/\1/p' <<<"$acquire_log")
    lease_token="${token:-$lease_token}"
    # No project-only fallback, including controllers that omit the token.
    require_lease_token || return 1
    emulator_serial >/dev/null || return 1
    token_tmp=$(mktemp "$lease_token_file.XXXXXX")
    printf '%s\n' "$lease_token" > "$token_tmp"
    mv -f -- "$token_tmp" "$lease_token_file"
    echo "Leased almon's shared device for $lease_project at $geometry@${density}dpi."
}

release_emulator() {
    require_lease_token || return 1
    "$emulatorctl" release "$lease_project" --lease "$lease_token" 9>&- || return 1
    rm -f -- "$lease_token_file"
}

wait_for_boot() {
    local attempt serial state boot
    for attempt in {1..90}; do
        # Transport readiness may be retried; lost ownership must fail immediately.
        serial=$(emulator_serial) || return 1
        state=$(adb_all -s "$serial" get-state 2>/dev/null || true)
        serial=$(emulator_serial) || return 1
        boot=$(adb_all -s "$serial" shell getprop sys.boot_completed 2>/dev/null || true)
        boot=${boot//$'\r'/}
        if [[ "$state" == device && "$boot" == 1 ]]; then
            emulator_serial >/dev/null || return 1
            echo "Android booted after at most ${attempt}s."
            return
        fi
        sleep 1
    done
    echo "Device did not finish booting. Inspect: emulatorctl status; journalctl --user -u almon-android-emulator" >&2
    exit 1
}

install_debug_app() {
    wait_for_boot
    run_dev env ANDROID_HOME="$sdk_root" "$android_root/gradlew" -p "$android_root" :app:assembleDebug
    adb install -r "$android_root/app/build/outputs/apk/debug/app-debug.apk"
    adb shell am force-stop io.github.genneth.pupil
    adb shell am start -W -n io.github.genneth.pupil/.MainActivity
}

verify_release_apk() {
    if [[ ! -f "$release_apk" ]]; then
        echo 'No signed app-release.apk was produced; configure release signing first.' >&2
        exit 1
    fi

    local verification actual_cert debuggable application_id version_name version_code
    verification=$(run_dev "$sdk_root/build-tools/36.0.0/apksigner" \
        verify --verbose --print-certs "$release_apk")
    actual_cert=$(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' <<<"$verification")
    if [[ "$actual_cert" != "$release_cert_sha256" ]]; then
        echo "Refusing APK signed by unexpected certificate: ${actual_cert:-none}" >&2
        exit 1
    fi
    if ! grep -Fqx 'Verified using v3 scheme (APK Signature Scheme v3): true' <<<"$verification"; then
        echo 'Refusing release APK without an APK Signature Scheme v3 signature.' >&2
        exit 1
    fi
    if ! grep -Fqx 'Number of signers: 1' <<<"$verification"; then
        echo 'Refusing release APK whose signer set is not exactly one key.' >&2
        exit 1
    fi

    debuggable=$(run_dev "$sdk_root/cmdline-tools/latest/bin/apkanalyzer" manifest debuggable "$release_apk")
    application_id=$(run_dev "$sdk_root/cmdline-tools/latest/bin/apkanalyzer" manifest application-id "$release_apk")
    version_name=$(run_dev "$sdk_root/cmdline-tools/latest/bin/apkanalyzer" manifest version-name "$release_apk")
    version_code=$(run_dev "$sdk_root/cmdline-tools/latest/bin/apkanalyzer" manifest version-code "$release_apk")
    [[ "$debuggable" == false ]] || { echo 'Refusing a debuggable release APK.' >&2; exit 1; }
    [[ "$application_id" == io.github.genneth.pupil ]] || { echo "Unexpected application id: $application_id" >&2; exit 1; }
    [[ "$version_name" == "$release_version_name" ]] || { echo "Unexpected version name: $version_name" >&2; exit 1; }
    [[ "$version_code" == "$release_version_code" ]] || { echo "Unexpected version code: $version_code" >&2; exit 1; }

    mkdir -p "$(dirname "$release_dist")"
    cp -- "$release_apk" "$release_dist"
    sha256sum "$release_dist" > "$release_dist.sha256"
    echo "Verified and exported signed, non-debuggable release: $release_dist"
    cat "$release_dist.sha256"
}

build_release_app() {
    # A credential-free build produces app-release-unsigned.apk. Removing the signed output first
    # prevents an older credentialled artifact from masquerading as the result of this build.
    rm -f -- "$release_apk" "$release_dist" "$release_dist.sha256"
    run_dev env ANDROID_HOME="$sdk_root" "$android_root/gradlew" -p "$android_root" :app:assembleRelease
    verify_release_apk
}

install_release_app() {
    wait_for_boot
    build_release_app
    # Only the disposable emulator is selected. Never automate the physical phone's one-time
    # debug-key migration: that uninstall and ColorOS reconfiguration require owner approval.
    adb uninstall io.github.genneth.pupil >/dev/null 2>&1 || true
    adb install "$release_apk"
    adb shell am force-stop io.github.genneth.pupil
    adb shell am start -W -n io.github.genneth.pupil/.MainActivity
}

run_ui_tests() {
    wait_for_boot
    local serial
    serial=$(emulator_serial)
    run_dev env ANDROID_HOME="$sdk_root" ANDROID_SERIAL="$serial" \
        "$android_root/gradlew" -p "$android_root" :app:connectedDebugAndroidTest
}

capture() {
    local name=${1:-pupil}
    mkdir -p "$loop_output"
    adb exec-out screencap -p > "$loop_output/$name.png"
    adb shell uiautomator dump "/sdcard/$name.xml" >/dev/null
    adb exec-out cat "/sdcard/$name.xml" > "$loop_output/$name.xml"
    echo "$loop_output/$name.png"
    echo "$loop_output/$name.xml"
}

case "${1:-}" in
    up)
        start_emulator "${2:-folded}"
        install_debug_app
        adb shell dumpsys SurfaceFlinger | grep -m1 'GLES:'
        ;;
    start) start_emulator "${2:-folded}" ;;
    wait) wait_for_boot ;;
    install) install_debug_app ;;
    install-release) install_release_app ;;
    verify-release) build_release_app ;;
    test-ui) run_ui_tests ;;
    capture) capture "${2:-pupil}" ;;
    # Explicit, never `wm size reset`: reset now means almon's 2248x2616 superset
    # panel, not the Find N6's folded 1140x2616. Density is restated too, since
    # a bare `wm size` leaves whatever density the last command set.
    folded) adb shell wm size "$geometry_folded"; adb shell wm density "$density" ;;
    unfolded) adb shell wm size "$geometry_unfolded"; adb shell wm density "$density" ;;
    renderer) adb shell dumpsys SurfaceFlinger | grep -m1 'GLES:' ;;
    stop) release_emulator ;;
    *)
        cat <<'USAGE'
Usage: android/scripts/android-loop COMMAND

  up [folded|unfolded]   lease almon's shared device, build, install, launch Pupil
  start [folded|unfolded] lease the shared device without building
  stop                   release the lease (stops the shared device)
  wait                   wait for Android to finish booting
  install                build, install, and launch the debug APK on the emulator
  install-release        build, verify, replace, and launch the permanent-key release on the emulator
  verify-release         build, verify, and export the signed 0.3.0 release
  test-ui                run Compose interaction tests on the emulator
  capture [name]         save a screenshot and UI hierarchy under target/android-loop
  folded                 restore the Find N6 folded display (413dp wide)
  unfolded               emulate the Find N6 814dp unfolded width
  renderer               print the renderer Android is actually using
USAGE
        exit 2
        ;;
esac
